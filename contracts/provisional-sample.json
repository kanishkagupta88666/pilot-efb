              "response": "Checked"
            },
            {
              "id": "fm100-p03225",
              "challenge": "Hydraulic System B",
              "response": "Closed"
            },
            {
              "id": "fm100-p03226",
              "challenge": "Oxygen Distribution",
              "response": "Verified"
            },
            {
