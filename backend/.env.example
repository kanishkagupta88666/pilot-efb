DJANGO_SECRET_KEY=replace-with-a-local-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database. Leave every line below commented out to use SQLite at
# backend/db.sqlite3. Django does not load this file by itself: copy it to
# backend/.env, then run `set -a; source backend/.env; set +a` in your shell.
#
# Option 1: separate variables. POSTGRES_DB switches the backend to PostgreSQL.
# POSTGRES_DB=pilot_efb
# POSTGRES_USER=pilot_efb
# POSTGRES_PASSWORD=replace-with-your-local-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
#
# Option 2: one URL. Do not combine it with option 1.
# DATABASE_URL=postgresql://pilot_efb:replace-with-your-local-password@127.0.0.1:5432/pilot_efb
#
# Optional: name of the database the test runner creates and drops.
# The default is test_ followed by the database name.
# POSTGRES_TEST_DB=test_pilot_efb
